# Backend API Endpoint
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Enable/Disable Mock API Mode
# Set to 'false' when running Express + MongoDB backend (npm run dev inside backend/)
# Set to 'true' for standalone client-side demo mode
VITE_ENABLE_MOCK_API=false

# Google Gemini API Key (Optional on frontend if configured in backend/.env)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
